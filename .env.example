# ─────────────────────────────────────────────────────────────────────────
# RSVP backend configuration
# Copy to `.env.local` for local development, and add these in Vercel →
# Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# In Vercel, create a store under Storage → Neon and this is injected
# automatically as DATABASE_URL — you don't need to set it there by hand.
# Locally you can leave this unset: RSVPs are saved to a temp JSON file so the
# flow works without any database.
DATABASE_URL=

# Credentials for the private admin dashboard at /admin (HTTP Basic Auth).
# Choose your own; required in every environment where /admin should be reachable.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
